# Staging only. Does not affect graphmytrade.com or existing sweet-voice-3fdf Worker.
name = "graphmytrade-99-shop-preview"
main = "src/worker.mjs"
compatibility_date = "2026-10-21"
workers_dev = true

[assets]
directory = "../public"
binding = "ASSETS"
run_worker_first = ["/store/api/*", "/store/p/*", "/sitemap.xml", "/store/admin", "/store/admin/*", "/store/media/*"]
not_found_handling = "404-page"

[vars]
# Keep blank until your PUBLIC product-only Google Sheet is published to CSV.
# Example: https://docs.google.com/spreadsheets/d/e/PUBLISHED_ID/pub?gid=0&single=true&output=csv
SHEET_CSV_URL = ""
